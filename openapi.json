            "title": "Request Id",
            "type": "string"
          },
          "retry_count": {
            "default": 0,
            "title": "Retry Count",
            "type": "integer"
          },
          "route": {
            "title": "Route",
            "type": "string"
          },
          "total_latency_ms": {
            "title": "Total Latency Ms",
            "type": "number"
          }
        },
        "required": [
          "request_id",
          "route",
          "provider",
          "total_latency_ms"
        ],
        "title": "InferrailMetadata",
        "type": "object"
      },

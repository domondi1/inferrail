      "InferrailMetadata": {
        "description": "Inferrail-specific extension data, not part of the OpenAI schema.\n\n``request_id`` (also the top-level response ``id``) and ``model`` (the\ntop-level response ``model``) are deliberately Inferrail's own request\nidentity, not the upstream provider's \u2014 they're what correlates this\nresponse back to its ``InferenceEvent``/``InferenceReceipt``, which\nexist independent of whatever id/model string a particular provider\nhappened to echo back. ``provider_request_id``/``raw_model`` below are\nthe provider's own values, carried through additively so they're never\nsilently discarded \u2014 never conflate the two.",
        "properties": {
          "provider": {
            "title": "Provider",
            "type": "string"
          },
          "provider_request_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }

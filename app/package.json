{
  "name": "inferrail-dashboard",
  "private": true,
  "version": "0.0.0",
  "description": "Inferrail local dashboard — a static SPA served by 'inferrail serve --app-mode' over the local control API (docs/adr/0016, docs/adr/0017).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
